      "item": [
        {
          "name": "Register (patient)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Patient\",\n  \"email\": \"new.patient@example.com\",\n  \"password\": \"secret12\",\n  \"phone\": \"01000000001\",\n  \"dateOfBirth\": \"2000-01-01\",\n  \"gender\": \"male\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json().data;",
                  "if (data && data.token) pm.collectionVariables.set(\"patientToken\", data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin",
