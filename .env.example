PORT=5001

# Supabase: Project Settings → Database → Connection string
# Pooled connection (port 6543), used by the app
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432), used by migrations
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Any long random text. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-text

# The website address (used for CORS and links in e-mails)
CLIENT_URL=http://localhost:5174

# E-mail (leave SMTP_HOST empty in development: e-mails are printed in the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Clinical <no-reply@clinical.local>"
