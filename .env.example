# .env.example
PORT=5001
NODE_ENV=development

MONGODB_URI=

JWT_SECRET=

# Used only by `npm run seed:admin`; keep these values in your local .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=

CLIENT_URL=https://example.com,https://admin-example.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder. Uploads are stored in <root>/images or <root>/cv.
CLOUDINARY_FOLDER=cms-crud-template
